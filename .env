VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ربط فيسبوك/إنستغرام التلقائي (بضغطة واحدة) — اختياري.
# أنشئ تطبيق فيسبوك على https://developers.facebook.com وضع الـ App ID هون.
# App ID عام وآمن بالواجهة الأمامية (مو سر). App Secret يُضبط فقط كسر على
# Supabase Edge Functions باسم FACEBOOK_APP_SECRET (و FACEBOOK_APP_ID أيضًا)
# عبر: supabase secrets set FACEBOOK_APP_ID=... FACEBOOK_APP_SECRET=...
VITE_FACEBOOK_APP_ID=your-facebook-app-id
# رابط خادم بوابة واتساب (مجلد whatsapp-server)
VITE_WHATSAPP_GATEWAY_URL=https://chat-ai-production-729c.up.railway.app
